generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"
  url = env("DATABASE_URL") }

enum Role { USER ADMIN }
enum UserStatus { ACTIVE SUSPENDED BLOCKED }
enum Category { ENGINEERING_TEXTBOOKS ACADEMIC_BOOKS REFERENCE_BOOKS HANDWRITTEN_NOTES PRINTED_NOTES QUESTION_PAPERS PRACTICAL_JOURNALS LAB_MANUALS STATIONERY CALCULATORS DRAWING_INSTRUMENTS COLLEGE_ACCESSORIES OTHER }
enum Condition { BRAND_NEW LIKE_NEW GOOD USED ACCEPTABLE }
enum ProductStatus { AVAILABLE RESERVED SOLD UNAVAILABLE HIDDEN REMOVED }
enum OrderStatus { PENDING ACCEPTED REJECTED MEETING_ARRANGED COMPLETED CANCELLED }
enum ReportStatus { OPEN REVIEWED DISMISSED }

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String?
  googleId     String?    @unique
  college      String?
  department   String?
  year         Int?
  phone        String?
  avatarPath   String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  warnings     Int        @default(0)
  createdAt    DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  products     Product[]
  cart         CartItem[]
  wishlist     Wishlist[]
  buyOrders    Order[]    @relation("buyer")
  sellOrders   Order[]    @relation("seller")
  messages     Message[]
  notifications Notification[]
  reportsMade  Report[]   @relation("reporter")
  reportsAgainst Report[] @relation("reportedSeller")
  convBuyer    Conversation[] @relation("convBuyer")
  convSeller   Conversation[] @relation("convSeller")
}

model Product {
  id          String        @id @default(uuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String
  pricePaise  Int
  category    Category
  subcategory String?
  condition   Condition
  college     String
  status      ProductStatus @default(AVAILABLE)
  priceFlagged Boolean      @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  images      ProductImage[]
  cartItems   CartItem[]
  wishlisted  Wishlist[]
  orders      Order[]
  reports     Report[]
  conversations Conversation[]
  @@index([status, category, createdAt])
  @@index([sellerId])
  @@index([pricePaise])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  position  Int     @default(0)
}

model CartItem {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, productId])
}

model Wishlist {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, productId])
}

model Conversation {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("convBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("convSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
  @@unique([productId, buyerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  @@index([conversationId, createdAt])
}

model Order {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  buyerId    String
  buyer      User        @relation("buyer", fields: [buyerId], references: [id])
  sellerId   String
  seller     User        @relation("seller", fields: [sellerId], references: [id])
  pricePaise Int
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  @@index([buyerId])
  @@index([sellerId])
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  sellerId   String?
  seller     User?        @relation("reportedSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String?
  createdAt DateTime @default(now())
}
